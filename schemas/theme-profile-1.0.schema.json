{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.local/content-factory/theme-profile-1.0.schema.json",
  "title": "Content Factory Theme Profile 1.0",
  "type": "object",
  "additionalProperties": false,
  "required": ["profileSchemaVersion", "identity", "compatibility", "postDefaults", "pageTypes", "sections", "composition", "siteDefaults", "assets", "policies"],
  "properties": {
    "profileSchemaVersion": {"type": "string", "const": "1.0"},
    "identity": {
      "type": "object", "additionalProperties": false,
      "required": ["profileId", "profileVersion", "siteKey"],
      "properties": {
        "profileId": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$"},
        "profileVersion": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"},
        "siteKey": {"type": "string", "minLength": 1}
      }
    },
    "compatibility": {
      "type": "object", "additionalProperties": false,
      "required": ["theme"],
      "properties": {
        "theme": {
          "type": "object", "additionalProperties": false, "required": ["stylesheet", "minVersion"],
          "properties": {"stylesheet": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}}, "minVersion": {"type": "string"}}
        }
      }
    },
    "postDefaults": {"type": "object"},
    "pageTypes": {"type": "object", "minProperties": 1},
    "sections": {
      "type": "object", "minProperties": 1,
      "additionalProperties": {
        "type": "object", "additionalProperties": false, "required": ["schema", "binding"],
        "properties": {
          "schema": {"type": "object", "required": ["type", "properties"]},
          "binding": {"type": "object", "required": ["blockName", "mapper"]},
          "rules": {"type": "array", "items": {"type": "string"}}
        }
      }
    },
    "composition": {"type": "object", "additionalProperties": false, "required": ["rootBlueprint"], "properties": {"rootBlueprint": {"type": "array", "minItems": 1, "items": {"type": "object"}}}},
    "siteDefaults": {"type": "object", "additionalProperties": false, "required": ["version", "values"], "properties": {"version": {"type": "string", "minLength": 1}, "values": {"type": "object"}}},
    "assets": {"type": "object", "additionalProperties": {"type": "object", "additionalProperties": false, "required": ["path"], "properties": {"path": {"type": "string", "minLength": 1}}}},
    "policies": {"type": "object"}
  }
}
