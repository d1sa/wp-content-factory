{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.local/content-factory/pagespec-1.0.schema.json",
  "title": "Content Factory PageSpec 1.0",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "sourceId", "pageType", "post", "seo", "sections"],
  "properties": {
    "schemaVersion": { "const": "1.0" },
    "sourceId": { "type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{2,159}$" },
    "pageType": { "type": "string", "minLength": 1 },
    "generatedAgainst": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "profileId": { "type": "string" },
        "profileVersion": { "type": "string" },
        "manifestHash": { "type": "string" }
      }
    },
    "target": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "siteKey": { "type": "string" },
        "profileId": { "type": "string" }
      }
    },
    "post": {
      "type": "object",
      "additionalProperties": false,
      "required": ["title", "slug"],
      "properties": {
        "title": { "type": "string", "minLength": 1 },
        "slug": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$" },
        "categoryLabel": { "type": "string" },
        "parent": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "sourceId": { "type": "string" },
            "path": { "type": "string", "pattern": "^/.*" }
          },
          "oneOf": [
            { "required": ["sourceId"], "not": { "required": ["path"] } },
            { "required": ["path"], "not": { "required": ["sourceId"] } }
          ]
        }
      }
    },
    "seo": {
      "type": "object",
      "additionalProperties": false,
      "required": ["title", "description"],
      "properties": {
        "title": { "type": "string", "minLength": 1 },
        "description": { "type": "string", "minLength": 1 },
        "primaryKeyword": { "type": "string" },
        "canonical": { "type": "string", "format": "uri" }
      }
    },
    "sections": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "type", "data"],
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$" },
          "type": { "type": "string", "minLength": 1 },
          "data": { "type": "object" }
        }
      }
    }
  }
}
