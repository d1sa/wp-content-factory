{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.local/content-factory/contract-bundle-1.0.schema.json",
  "title": "Content Factory Contract Bundle 1.0",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contractVersion",
    "contractHash",
    "pageSpecVersion",
    "identity",
    "pageSpecSchema",
    "semanticProfileSchema",
    "pageTypes",
    "siteDefaults",
    "assets",
    "policies",
    "examples",
    "conversionGuidance",
    "selfCheck"
  ],
  "properties": {
    "contractVersion": { "type": "string", "const": "1.0" },
    "contractHash": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" },
    "pageSpecVersion": { "type": "string", "const": "1.1" },
    "identity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["siteKey", "profileId", "profileVersion", "siteDefaultsVersion", "manifestHash"],
      "properties": {
        "siteKey": { "type": "string", "minLength": 1 },
        "profileId": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$" },
        "profileVersion": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$" },
        "siteDefaultsVersion": { "type": "string", "minLength": 1 },
        "manifestHash": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" }
      }
    },
    "pageSpecSchema": { "type": "object" },
    "semanticProfileSchema": { "type": "object" },
    "pageTypes": { "type": "object", "minProperties": 1 },
    "siteDefaults": { "type": "object" },
    "assets": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "path": { "type": "string", "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$)).+" },
          "label": { "type": "string" },
          "mimeType": { "type": "string" },
          "width": { "type": "integer", "minimum": 1 },
          "height": { "type": "integer", "minimum": 1 }
        }
      }
    },
    "policies": { "type": "object" },
    "examples": { "type": "array" },
    "conversionGuidance": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 }
    },
    "selfCheck": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "issues"],
      "properties": {
        "status": { "type": "string", "enum": ["compatible", "compatible_with_warnings", "incompatible"] },
        "issues": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["code", "severity", "path", "message"],
            "properties": {
              "code": { "type": "string" },
              "severity": { "type": "string", "enum": ["error", "warning", "info"] },
              "path": { "type": "string" },
              "message": { "type": "string" },
              "expected": { "type": "string" },
              "suggestion": { "type": "string" },
              "docsRef": { "type": "string" }
            }
          }
        }
      }
    }
  }
}
