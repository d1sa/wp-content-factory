{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.local/content-factory/theme-manifest-1.0.schema.json",
  "title": "Content Factory Theme Manifest 1.0",
  "type": "object",
  "additionalProperties": false,
  "required": ["manifestSchemaVersion", "profileId", "profileVersion", "siteKey", "themeCompatibility", "pageSpecVersions", "postDefaults", "pageTypes", "sections", "rootBlueprint", "siteDefaults", "assets", "aliases", "policies"],
  "properties": {
    "manifestSchemaVersion": { "const": "1.0" },
    "profileId": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$" },
    "profileVersion": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$" },
    "siteKey": { "type": "string", "minLength": 1 },
    "themeCompatibility": {
      "type": "object", "additionalProperties": false, "required": ["stylesheet", "minVersion"],
      "properties": {"stylesheet": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}}, "minVersion": {"type": "string"}}
    },
    "pageSpecVersions": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string" } },
    "postDefaults": {
      "type": "object", "additionalProperties": false, "required": ["postType", "pageTemplate", "status"],
      "properties": {"postType": {"const": "page"}, "pageTemplate": {"type": "string", "minLength": 1}, "status": {"const": "draft"}}
    },
    "pageTypes": {
      "type": "object", "minProperties": 1,
      "additionalProperties": {"type": "object", "additionalProperties": false, "required": ["occurrences", "parentLink"], "properties": {"occurrences": {"type": "object", "additionalProperties": {"type": "object", "additionalProperties": false, "required": ["min", "max"], "properties": {"min": {"type": "integer", "minimum": 0}, "max": {"type": "integer", "minimum": 0}}}}, "parentLink": {"type": "string"}}}
    },
    "sections": {
      "type": "object", "minProperties": 1,
      "additionalProperties": {"type": "object", "required": ["blockName", "allowedData", "requiredData", "schema", "mappingAttributes"], "properties": {"blockName": {"type": "string", "pattern": "^[a-z0-9-]+/[a-z0-9-]+$"}, "allowedData": {"type": "array", "uniqueItems": true, "items": {"type": "string"}}, "requiredData": {"type": "array", "uniqueItems": true, "items": {"type": "string"}}, "schema": {"type": "object", "required": ["type", "properties"]}, "mappingAttributes": {"type": "array", "items": {"type": "string"}}}}
    },
    "rootBlueprint": { "type": "array", "minItems": 1, "items": {"type": "object", "required": ["blockName", "position", "min", "max"]} },
    "siteDefaults": { "type": "object" },
    "assets": { "type": "object", "additionalProperties": {"type": "object", "additionalProperties": false, "required": ["path"], "properties": {"path": {"type": "string", "minLength": 1}}} },
    "aliases": { "type": "object", "additionalProperties": {"type": "string", "minLength": 1} },
    "policies": { "type": "object" }
  }
}
