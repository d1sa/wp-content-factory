{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.local/content-factory/pagespec-1.1.schema.json",
  "title": "Content Factory PageSpec 1.1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "sourceId", "pageType", "generatedAgainst", "target", "post", "seo", "sections"],
  "properties": {
    "schemaVersion": { "type": "string", "const": "1.1" },
    "sourceId": { "type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{2,159}$" },
    "pageType": { "type": "string", "minLength": 1 },
    "generatedAgainst": {
      "type": "object",
      "additionalProperties": false,
      "required": ["profileId", "profileVersion", "manifestHash"],
      "properties": {
        "profileId": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$" },
        "profileVersion": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$" },
        "manifestHash": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" }
      }
    },
    "target": {
      "type": "object",
      "additionalProperties": false,
      "required": ["siteKey", "profileId"],
      "properties": {
        "siteKey": { "type": "string", "minLength": 1 },
        "profileId": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$" }
      }
    },
    "post": {
      "type": "object",
      "additionalProperties": false,
      "required": ["title", "slug"],
      "properties": {
        "title": { "type": "string", "minLength": 1 },
        "slug": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$" },
        "categoryLabel": { "type": "string" },
        "parent": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "sourceId": { "type": "string" },
            "path": { "type": "string", "pattern": "^/.*" }
          },
          "oneOf": [
            { "required": ["sourceId"], "not": { "required": ["path"] } },
            { "required": ["path"], "not": { "required": ["sourceId"] } }
          ]
        }
      }
    },
    "seo": {
      "type": "object",
      "additionalProperties": false,
      "required": ["title", "description"],
      "properties": {
        "title": { "type": "string", "minLength": 1 },
        "description": { "type": "string", "minLength": 1 },
        "primaryKeyword": { "type": "string" },
        "canonical": { "type": "string", "format": "uri" }
      }
    },
    "sections": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "type", "data"],
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$" },
          "type": { "type": "string", "minLength": 1 },
          "data": { "type": "object" }
        }
      }
    }
  },
  "$defs": {
    "link": {
      "oneOf": [
        { "type": "object", "additionalProperties": false, "required": ["kind", "anchor"], "properties": { "kind": { "type": "string", "const": "anchor" }, "anchor": { "type": "string", "pattern": "^[A-Za-z][A-Za-z0-9_-]*$" } } },
        { "type": "object", "additionalProperties": false, "required": ["kind", "sourceId"], "properties": { "kind": { "type": "string", "const": "page" }, "sourceId": { "type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{2,159}$" } } },
        { "type": "object", "additionalProperties": false, "required": ["kind", "path"], "properties": { "kind": { "type": "string", "const": "path" }, "path": { "type": "string", "pattern": "^/" } } },
        { "type": "object", "additionalProperties": false, "required": ["kind", "url"], "properties": { "kind": { "type": "string", "const": "external" }, "url": { "type": "string", "format": "uri" }, "newTab": { "type": "boolean" } } },
        { "type": "object", "additionalProperties": false, "required": ["kind", "value"], "properties": { "kind": { "type": "string", "const": "tel" }, "value": { "type": "string" } } },
        { "type": "object", "additionalProperties": false, "required": ["kind", "value"], "properties": { "kind": { "type": "string", "const": "mailto" }, "value": { "type": "string", "format": "email" } } }
      ]
    },
    "asset": {
      "oneOf": [
        { "type": "object", "additionalProperties": false, "required": ["source", "ref", "alt"], "properties": { "source": { "type": "string", "const": "themeAsset" }, "ref": { "type": "string", "minLength": 1 }, "alt": { "type": "string" } } },
        { "type": "object", "additionalProperties": false, "required": ["source", "id", "alt"], "properties": { "source": { "type": "string", "const": "mediaId" }, "id": { "type": "integer", "minimum": 1 }, "alt": { "type": "string" } } },
        { "type": "object", "additionalProperties": false, "required": ["source", "url", "alt"], "properties": { "source": { "type": "string", "const": "mediaUrl" }, "url": { "type": "string", "format": "uri" }, "alt": { "type": "string" } } },
        { "type": "object", "additionalProperties": false, "required": ["source", "url", "alt"], "properties": { "source": { "type": "string", "const": "externalUrl" }, "url": { "type": "string", "format": "uri" }, "alt": { "type": "string" } } },
        { "type": "object", "additionalProperties": false, "required": ["source", "alt"], "properties": { "source": { "type": "string", "const": "none" }, "alt": { "type": "string" } } }
      ]
    }
  }
}
