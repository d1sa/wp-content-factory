  "sections": {
    "hero": {
      "schema": {"type": "object", "additionalProperties": false, "required": ["title", "lead", "primaryAction"], "properties": {"kicker": {"type": "string"}, "title": {"type": "string", "minLength": 1}, "lead": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}}, "primaryAction": {"type": "object", "additionalProperties": false, "required": ["label"], "properties": {"label": {"type": "string", "minLength": 1}, "link": {"type": "object"}}}, "benefits": {"type": "array", "maxItems": 3, "items": {"type": "string", "minLength": 1}}, "image": {"type": "object"}, "badge": {"type": "object"}, "note": {"type": "object"}}},
      "binding": {"mapper": "potolki.hero", "blockName": "potolki/inner-hero", "allowedChildren": ["core/paragraph", "core/heading", "core/list", "core/buttons"]},
      "rules": ["potolki.hero"]
    },
    "article": {
      "schema": {"type": "object", "additionalProperties": false, "required": ["title", "body"], "properties": {"title": {"type": "string", "minLength": 1}, "accent": {"type": "boolean"}, "body": {"type": "array", "minItems": 1, "items": {"type": "object", "additionalProperties": true, "required": ["type"], "properties": {"type": {"type": "string", "enum": ["paragraph", "heading", "list", "buttons"]}}}}}},
      "binding": {"mapper": "potolki.article", "blockName": "potolki/inner-article", "allowedChildren": ["core/paragraph", "core/heading", "core/list", "core/buttons"]},
      "rules": ["potolki.article"]
    },
    "catalog": {
      "schema": {"type": "object", "additionalProperties": false, "required": ["title", "items"], "properties": {"kicker": {"type": "string"}, "title": {"type": "string", "minLength": 1}, "items": {"type": "array", "minItems": 1, "items": {"type": "object", "additionalProperties": false, "required": ["title", "text", "action", "image"], "properties": {"title": {"type": "string", "minLength": 1}, "text": {"type": "string", "minLength": 1}, "action": {"type": "object"}, "image": {"type": "object"}}}}}},
      "binding": {
        "mapper": "generic", "blockName": "potolki/inner-catalog",
        "attributes": {
          "sectionId": {"transform": "direct", "source": "section.id"},
          "kicker": {"transform": "coalesce", "sources": ["data.kicker"], "fallback": "Каталог"},
          "title": {"transform": "direct", "source": "data.title"}
        },
        "repeat": {
          "source": "data.items", "blockName": "potolki/inner-catalog-card",
          "attributes": {
            "title": {"transform": "inlineRichText", "source": "item.title", "allowLinks": false},
            "text": {"transform": "inlineRichText", "source": "item.text", "allowLinks": false},
            "linkLabel": {"transform": "plainText", "source": "item.action.label"},
            "linkUrl": {"transform": "link", "source": "item.action.link", "part": "url"},
            "linkTarget": {"transform": "link", "source": "item.action.link", "part": "target"},
            "linkRel": {"transform": "link", "source": "item.action.link", "part": "rel"},
            "imageId": {"transform": "asset", "source": "item.image", "part": "id"},
            "imageUrl": {"transform": "asset", "source": "item.image", "part": "url"},
            "imageAlt": {"transform": "asset", "source": "item.image", "part": "alt"}
          }
        }
      },
      "rules": ["potolki.catalog"]
    },
    "steps": {
      "schema": {"type": "object", "additionalProperties": false, "required": ["title", "items"], "properties": {"kicker": {"type": "string"}, "title": {"type": "string", "minLength": 1}, "items": {"type": "array", "minItems": 1, "items": {"type": "object", "additionalProperties": false, "required": ["title", "text"], "properties": {"title": {"type": "string", "minLength": 1}, "text": {"type": "string", "minLength": 1}}}}}},
      "binding": {
        "mapper": "generic", "blockName": "potolki/inner-steps",
        "attributes": {"sectionId": {"transform": "direct", "source": "section.id"}, "kicker": {"transform": "coalesce", "sources": ["data.kicker"], "fallback": "Процесс"}, "title": {"transform": "direct", "source": "data.title"}},
        "repeat": {"source": "data.items", "blockName": "potolki/inner-step", "attributes": {"number": {"transform": "index", "mode": "oneBasedString"}, "title": {"transform": "plainText", "source": "item.title"}, "text": {"transform": "inlineRichText", "source": "item.text", "allowLinks": true}}}
      },
      "rules": ["potolki.steps"]
    },
    "faq": {
      "schema": {"type": "object", "additionalProperties": false, "required": ["title", "items"], "properties": {"kicker": {"type": "string"}, "title": {"type": "string", "minLength": 1}, "items": {"type": "array", "minItems": 1, "items": {"type": "object", "additionalProperties": false, "required": ["question", "answer"], "properties": {"question": {"type": "string", "minLength": 1}, "answer": {"type": "string", "minLength": 1}}}}}},
      "binding": {
        "mapper": "generic", "blockName": "potolki/inner-faq",
