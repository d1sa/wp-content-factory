        "repeat": {"source": "data.items", "blockName": "potolki/inner-faq-item", "attributes": {"question": {"transform": "plainText", "source": "item.question"}, "answer": {"transform": "inlineRichText", "source": "item.answer", "allowLinks": true}, "isOpen": {"transform": "index", "mode": "firstBoolean"}}}
      },
      "rules": ["potolki.faq", "faq.unique"]
    },
    "parent-link": {
      "schema": {"type": "object", "additionalProperties": false, "properties": {"label": {"type": "string"}, "linkLabel": {"type": "string"}}},
      "binding": {"mapper": "potolki.parent-link", "blockName": "potolki/inner-parent-link"},
      "rules": ["potolki.parent-link"]
    },
    "cta": {
      "schema": {"type": "object", "additionalProperties": false, "required": ["title", "text", "primaryAction"], "properties": {"variant": {"type": "string", "enum": ["form", "links"]}, "kicker": {"type": "string"}, "title": {"type": "string", "minLength": 1}, "text": {"type": "string", "minLength": 1}, "benefits": {"type": "array", "maxItems": 2, "items": {"type": "string", "minLength": 1}}, "primaryAction": {"type": "object"}, "secondaryAction": {"type": "object"}}},
      "binding": {"mapper": "potolki.cta", "blockName": "potolki/inner-cta"},
      "rules": ["potolki.cta"]
    }
  },
