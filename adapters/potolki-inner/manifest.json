{
  "manifestSchemaVersion": "1.0",
  "profileId": "potolki-inner",
  "profileVersion": "1.1.0",
  "siteKey": "potolkinaveka40",
  "themeCompatibility": {
    "stylesheet": ["potolki-wp"],
    "minVersion": "1.0.0"
  },
  "pageSpecVersions": ["1.0"],
  "postDefaults": {
    "postType": "page",
    "pageTemplate": "template-full-width.php",
    "status": "draft"
  },
  "pageTypes": {
    "service-detail": {
      "occurrences": {
        "hero": {"min": 1, "max": 1},
        "article": {"min": 1, "max": 10},
        "catalog": {"min": 0, "max": 1},
        "steps": {"min": 0, "max": 1},
        "faq": {"min": 1, "max": 1},
        "parent-link": {"min": 0, "max": 1},
        "cta": {"min": 1, "max": 1}
      },
      "parentLink": "autoWhenParent"
    },
    "service-category": {
      "occurrences": {
        "hero": {"min": 1, "max": 1},
        "article": {"min": 0, "max": 10},
        "catalog": {"min": 1, "max": 1},
        "steps": {"min": 0, "max": 1},
        "faq": {"min": 1, "max": 1},
        "parent-link": {"min": 0, "max": 1},
        "cta": {"min": 1, "max": 1}
      },
      "parentLink": "autoWhenParent"
    }
  },
  "sections": {
    "hero": {
      "blockName": "potolki/inner-hero",
      "allowedData": ["kicker", "title", "lead", "primaryAction", "benefits", "image", "badge", "note"],
      "requiredData": ["title", "lead", "primaryAction"],
      "schema": {
        "type": "object", "additionalProperties": false, "required": ["title", "lead", "primaryAction"],
        "properties": {
          "kicker": {"type": "string"}, "title": {"type": "string", "minLength": 1}, "lead": {"type": "string", "minLength": 1},
          "primaryAction": {"type": "object", "additionalProperties": false, "required": ["label"], "properties": {"label": {"type": "string", "minLength": 1}, "link": {"type": "object"}}},
          "benefits": {"type": "array", "maxItems": 3, "items": {"type": "string", "minLength": 1}},
          "image": {"type": "object"}, "badge": {"type": "object"}, "note": {"type": "object"}
        }
      },
      "mappingAttributes": ["kicker", "title", "lead1", "lead2", "buttonLabel", "buttonUrl", "buttonTarget", "buttonRel", "phoneCaption", "phoneLabel", "phoneUrl", "benefit1", "benefit2", "benefit3", "imageId", "imageUrl", "imageAlt", "badgeValue", "badgeText", "noteTitle", "noteText"]
    },
    "article": {
      "blockName": "potolki/inner-article",
      "allowedData": ["title", "accent", "body"],
      "requiredData": ["title", "body"],
      "schema": {
        "type": "object", "additionalProperties": false, "required": ["title", "body"],
        "properties": {
          "title": {"type": "string", "minLength": 1}, "accent": {"type": "boolean"},
          "body": {"type": "array", "minItems": 1, "items": {"type": "object", "additionalProperties": true, "required": ["type"], "properties": {"type": {"type": "string", "enum": ["paragraph", "heading", "list", "buttons"]}}}}
        }
      },
      "mappingAttributes": ["sectionId", "sectionIndex", "title", "accent"],
      "allowedChildren": ["core/paragraph", "core/heading", "core/list", "core/buttons"]
    },
    "catalog": {
      "blockName": "potolki/inner-catalog",
      "allowedData": ["kicker", "title", "items"],
      "requiredData": ["title", "items"],
      "schema": {
        "type": "object", "additionalProperties": false, "required": ["title", "items"],
        "properties": {
          "kicker": {"type": "string"}, "title": {"type": "string", "minLength": 1},
          "items": {"type": "array", "minItems": 1, "items": {"type": "object", "additionalProperties": false, "required": ["title", "text", "action", "image"], "properties": {"title": {"type": "string", "minLength": 1}, "text": {"type": "string", "minLength": 1}, "action": {"type": "object"}, "image": {"type": "object"}}}}
        }
      },
      "mappingAttributes": ["sectionId", "kicker", "title"],
      "childBlockName": "potolki/inner-catalog-card",
      "childMappingAttributes": ["title", "text", "linkLabel", "linkUrl", "linkTarget", "linkRel", "imageId", "imageUrl", "imageAlt"]
    },
    "steps": {
      "blockName": "potolki/inner-steps",
      "allowedData": ["kicker", "title", "items"],
      "requiredData": ["title", "items"],
      "schema": {
        "type": "object", "additionalProperties": false, "required": ["title", "items"],
        "properties": {
          "kicker": {"type": "string"}, "title": {"type": "string", "minLength": 1},
          "items": {"type": "array", "minItems": 2, "maxItems": 8, "items": {"type": "object", "additionalProperties": false, "required": ["title", "text"], "properties": {"title": {"type": "string", "minLength": 1}, "text": {"type": "string", "minLength": 1}}}}
        }
      },
      "mappingAttributes": ["sectionId", "kicker", "title"],
      "childBlockName": "potolki/inner-step",
      "childMappingAttributes": ["number", "title", "text"]
    },
    "faq": {
      "blockName": "potolki/inner-faq",
      "allowedData": ["kicker", "title", "items"],
      "requiredData": ["title", "items"],
      "schema": {
        "type": "object", "additionalProperties": false, "required": ["title", "items"],
        "properties": {
          "kicker": {"type": "string"}, "title": {"type": "string", "minLength": 1},
          "items": {"type": "array", "minItems": 3, "maxItems": 10, "items": {"type": "object", "additionalProperties": false, "required": ["question", "answer"], "properties": {"question": {"type": "string", "minLength": 1}, "answer": {"type": "string", "minLength": 1}}}}
        }
      },
      "mappingAttributes": ["sectionId", "kicker", "title"],
      "childBlockName": "potolki/inner-faq-item",
      "childMappingAttributes": ["question", "answer", "isOpen"]
    },
    "parent-link": {
      "blockName": "potolki/inner-parent-link",
      "allowedData": ["label", "linkLabel"],
      "requiredData": [],
      "schema": {"type": "object", "additionalProperties": false, "properties": {"label": {"type": "string"}, "linkLabel": {"type": "string"}}},
      "mappingAttributes": ["label", "linkLabel", "linkUrl"]
    },
    "cta": {
      "blockName": "potolki/inner-cta",
      "allowedData": ["variant", "kicker", "title", "text", "benefits", "primaryAction", "secondaryAction"],
      "requiredData": ["title", "text", "primaryAction"],
      "schema": {
        "type": "object", "additionalProperties": false, "required": ["title", "text", "primaryAction"],
        "properties": {
          "variant": {"type": "string", "enum": ["form", "links"]}, "kicker": {"type": "string"}, "title": {"type": "string", "minLength": 1}, "text": {"type": "string", "minLength": 1},
          "benefits": {"type": "array", "maxItems": 2, "items": {"type": "string", "minLength": 1}},
          "primaryAction": {"type": "object"}, "secondaryAction": {"type": "object"}
        }
      },
      "mappingAttributes": ["sectionId", "variant", "kicker", "title", "text", "benefit1", "benefit2", "nameLabel", "namePlaceholder", "phoneLabel", "phonePlaceholder", "buttonLabel", "buttonUrl", "buttonTarget", "buttonRel", "secondaryLabel", "secondaryUrl", "phoneCtaLabel", "phoneCtaUrl", "formNote", "ymCounterId", "ymGoal"]
    }
  },
  "rootBlueprint": [
    {
      "blockName": "potolki/inner-hero",
      "sectionType": "hero",
      "position": "first",
      "min": 1,
      "max": 1
    },
    {
